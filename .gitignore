# Third-party datasheets and their text extracts: local only
docs/datasheets/*.pdf
docs/datasheets/*.txt

# Firmware images, flash dumps and captures. A dump of a real bridge holds
# its network key and identity: none of these may ever be committed.
*.bin
*.hex
*.elf
*.srec
*.s19
*.dfu
*.uf2
*.img
*.dump
*.raw
*.sal

# SDR captures contain the owner's stock network traffic
*.cu8
*.cs8
*.cs16
*.cf32
*.iq
*.wav
*.sigmf-data
*.sigmf-meta
*.log
unmodded*
original/
out/
out_old/
dumps/
backup*/
ib01_*

# Keys and certificates (TLS)
*.pem
*.key
*.der
*.cer
*.crt
*.csr
*.srl
*.p12

# Build output
build/
build-debug/
build-release/
*.map

# Editor and OS files
.DS_Store
*~

# Cortex Debug register state
.vscode/.cortex-debug.registers.state.json

# Local provisioning: the bridge's serial and EUI-64 and the trust anchor
# path (cmake/CMakeLists.txt, docs/build.md P4). Template:
# config/local.cmake.example
config/local.cmake
